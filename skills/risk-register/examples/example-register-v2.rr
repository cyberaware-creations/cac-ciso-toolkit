    },
    {
      "id": "R-006",
      "title": "Unpatched internet-facing VPN appliance enables ransomware",
      "description": "If an internet-facing VPN appliance remains unpatched against a known exploited vulnerability, then an intrusion operator gains network entry and deploys ransomware across the estate.",
      "category": "PR",
      "theme": "infrastructure",
      "owner": "Infrastructure Lead",
      "inherent": {
        "likelihood": 4,
        "impact": 5
      },
      "response": {
        "type": "mitigate",
        "description": "Emergency patch window, WAF virtual patch, EDR on the DMZ segment",
        "cost": 60000
      },
      "residual": {
        "likelihood": 2,
        "impact": 4
      },
      "status": "open",
      "acceptance": null,
      "reviewDate": "2026-06-30",
      "csfSubcategoryId": "PR.PS-02"
    },
    {
      "id": "R-007",
      "title": "Business email compromise redirects a supplier payment",
      "description": "If an attacker impersonates an executive or a supplier over email, then finance redirects a live payment to an attacker-controlled account before the fraud is detected.",
      "category": "PR",
      "theme": "identity",
      "owner": "Finance Operations Manager",
      "inherent": {
        "likelihood": 4,
        "impact": 4
      },
      "response": {
        "type": "mitigate",
        "description": "Callback verification on bank-detail changes, DMARC rollout in progress",
        "cost": 15000
      },
      "residual": {
        "likelihood": 3,
        "impact": 5
      },
      "status": "open",
      "acceptance": null,
      "reviewDate": "2026-12-01",
      "csfSubcategoryId": "PR.DS-02"
    },
    {
      "id": "R-008",
      "title": "Insider exfiltration of customer data via unmanaged endpoints",
      "description": "If a departing or disgruntled employee copies customer records to personal storage, then regulated data leaves the estate with no detective control in the path.",
      "category": "PR",
      "theme": "data",
      "owner": "",
      "inherent": {
        "likelihood": 4,
        "impact": 4
      },
      "response": {
        "type": "mitigate",
        "description": "DLP in monitor mode, leaver checklist; no owner assigned yet"
      },
      "residual": {
        "likelihood": 2,
        "impact": 4
      },
      "status": "open",
      "acceptance": null,
      "reviewDate": "2027-01-15",
      "csfSubcategoryId": "PR.DS-01"
    },
    {
      "id": "R-009",
      "title": "Alert backlog delays detection of an active intrusion",
      "description": "If security alerts queue faster than the team can triage them, then an active intrusion goes unnoticed long enough for the attacker to reach crown-jewel systems.",
      "category": "DE",
      "theme": "detection",
      "owner": "SOC Manager",
      "inherent": {
        "likelihood": 4,
        "impact": 4
      },
      "response": {
        "type": "mitigate",
        "description": "Tuning of noisy rules; second-shift analyst requisition open",
        "cost": 120000
      },
      "residual": {
        "likelihood": 2,
        "impact": 3
      },
      "status": "open",
      "acceptance": null,
      "reviewDate": "2026-07-01",
      "csfSubcategoryId": "DE.AE-02"
    },
    {
      "id": "R-010",
      "title": "Shadow IT SaaS handles company data outside governance",
      "description": "If teams adopt SaaS tools without review, then company data is processed under contracts and controls nobody has assessed.",
      "category": "GV",
      "theme": null,
      "owner": "IT Director",
      "inherent": {
        "likelihood": 3,
        "impact": 3
      },
      "response": {
        "type": "accept",
        "description": "CASB discovery reporting monthly; no blocking enforcement"
      },
      "residual": {
        "likelihood": 2,
        "impact": 3
      },
      "status": "open",
      "acceptance": {
        "approver": "IT Director",
        "justification": "Discovery-only coverage is proportionate for low-sensitivity collaboration tools; no regulated data identified in the CASB inventory",
        "acceptedDate": "2026-01-15",
        "expiryDate": "2026-07-15",
        "revalidationDate": "2026-04-15"
      },
      "reviewDate": "2026-11-30",
      "csfSubcategoryId": "GV.SC-04"
    },
    {
      "id": "R-011",
      "title": "Leaked cloud access keys enable resource abuse",
      "description": "If long-lived cloud access keys are committed to a code repository, then an attacker uses them to spin up resources or reach production data before the key is rotated.",
      "category": "PR",
      "theme": "infrastructure",
      "owner": "Head of Cloud",
      "inherent": {
        "likelihood": 4,
        "impact": 4
      },
      "response": {
        "type": "accept",
        "description": "Secret scanning on push, short-lived credentials for CI, billing anomaly alerts",
        "cost": 20000
      },
      "residual": {
        "likelihood": 2,
        "impact": 3
      },
      "status": "open",
      "acceptance": {
        "approver": "Head of Cloud",
        "justification": "Secret scanning plus short-lived CI credentials keep residual within appetite; full rotation to workload identity is a FY27 programme",
        "acceptedDate": "2026-02-01",
        "expiryDate": "2027-02-01",
        "revalidationDate": "2026-06-30"
      },
      "reviewDate": "2026-10-15",
      "csfSubcategoryId": "PR.AA-01"
    }
  ],
